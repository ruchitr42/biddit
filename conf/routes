# Routes
# This file defines all application routes (Higher priority routes first)
# https://www.playframework.com/documentation/latest/ScalaRouting
# ~~~~

# An example controller showing a sample home page
#GET     /                           controllers.HomeController.index()

# Map static resources from the /public folder to the /assets URL path
GET     /assets/*file               controllers.Assets.versioned(path="/public", file: Asset)



GET     /                           controllers.Application.index
POST    /users/register             controllers.UserController.register
POST    /users/login                controllers.UserController.login
POST    /:userId/post               controllers.PostController.create(userId: Long)
GET     /posts/:postId              controllers.PostController.get(postId: Long)
POST    /posts/:postId/like         controllers.LikeController.like(postId: Long)
DELETE  /posts/:postId/like         controllers.LikeController.unlike(postId: Long)
GET     /posts/:postId/likes        controllers.LikeController.getLikeCount(postId: Long)
POST    /posts/:postId/likers       controllers.LikeController.getLikers(postId: Long)
POST    /posts/:postId/comments     controllers.CommentController.addComment(postId: Long)
GET     /posts/:postId/comments     controllers.CommentController.getComments(postId: Long)
POST    /posts/:postId/bookmark     controllers.BookmarkController.bookmark(postId: Long)
DELETE  /posts/:postId/bookmark     controllers.BookmarkController.unbookmark(postId: Long)
GET     /users/:userId/bookmarks    controllers.BookmarkController.getBookmarks(userId: Long)